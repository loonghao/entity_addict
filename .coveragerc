[run]
branch = True
# Was `src/photoshop`, copied from another project: coverage then measured a
# package that does not exist here and collected no data at all.
source = entity_addict

[report]
exclude_lines =
    if self.debug:
    pragma: no cover
    raise NotImplementedError
    if __name__ == .__main__.:
ignore_errors = True
omit =
    test/*
